# Required
GEMINI_API_KEY=
TAVILY_API_KEY=

# Optional: switch the LLM provider (gemini | anthropic)
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=

# Optional: model overrides
MODEL_MAIN=gemini-3.6-flash
MODEL_FAST=gemini-3.5-flash-lite
# Tried in order when a model is overloaded or out of its daily quota
MODEL_FALLBACK=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional: server port and planner budget
PORT=8787
PLANNER_TIMEOUT_MS=3500

# Optional: pin "now" (ISO timestamp) for evals and seeding
DEV_NOW=
